/* pages/rFail/rFail.wxss - 按截图重写 */
.page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding: 24rpx 28rpx 80rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 28rpx;
  padding-left: 4rpx;
}

/* 大卡推荐 */
.featured {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 48rpx;
}
.featured__img {
  width: 100%;
  height: 460rpx;
  display: block;
}
.featured__name {
  padding: 24rpx 28rpx 28rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

/* 相似景点 */
.section { margin-bottom: 60rpx; }
.section__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}
.similars {
  display: flex;
  gap: 20rpx;
}
.similar {
  flex: 1;
  background-color: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.similar__img {
  width: 100%;
  height: 260rpx;
  display: block;
}
.similar__name {
  display: block;
  padding: 16rpx 20rpx 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
}

/* 重新识别按钮 */
.again {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 60rpx auto 0;
  width: 64%;
  padding: 26rpx 0;
  background-color: #fff;
  border-radius: 999rpx;
  border: 2rpx solid #e0c88f;
}
.again__icon {
  width: 40rpx;
  height: 40rpx;
}
.again__text {
  font-size: 30rpx;
  color: #c9a24b;
  font-weight: 500;
}
