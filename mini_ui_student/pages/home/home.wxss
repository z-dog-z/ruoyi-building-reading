/* pages/home/home.wxss */
.home {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ============ 顶部轮播 ============ */
.banner { position: relative; width: 100%; height: 500rpx; background-color: #eee; }
.banner__swiper { width: 100%; height: 100%; }
.banner__img { width: 100%; height: 100%; display: block; }
.banner__dots {
  position: absolute; bottom: 20rpx; left: 0; right: 0;
  display: flex; justify-content: center; gap: 10rpx;
}
.banner__dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.45); transition: all 0.25s;
}
.banner__dot--active { width: 30rpx; border-radius: 999rpx; background-color: #fff; }

.card {
  display: flex; align-items: center;
  padding: 28rpx 32rpx; margin: 24rpx;
  background-color: #fff; border-radius: 12rpx;
}
.card__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  /* 黑色喇叭 PNG 染成微信绿 #07c160 */
  filter: invert(56%) sepia(85%) saturate(2487%) hue-rotate(88deg) brightness(96%) contrast(85%);
}
.card__tag { font-size: 28rpx; color: #07c160; }
.card__sep { margin: 0 16rpx; color: #ddd; }
.card__title { font-size: 30rpx; color: #222; }
.card__arrow { margin-left: auto; font-size: 44rpx; color: #bbb; }

/* ============ 热剧游山农大 ============ */
.section { padding: 0 24rpx; margin-bottom: 24rpx; }
.section__head {
  display: flex; justify-content: space-between;
  align-items: baseline; margin-bottom: 20rpx;
}
.section__title { font-size: 34rpx; font-weight: 600; color: #222; }
.section__more { font-size: 26rpx; color: #999; }
.section__scroll { white-space: nowrap; }
.video-card {
  display: inline-block; vertical-align: top;
  width: 260rpx; margin-right: 20rpx;
  background-color: #fff; border-radius: 14rpx; overflow: hidden;
}
.video-card__cover { width: 260rpx; height: 195rpx; display: block; }
.video-card__name {
  display: block; padding: 14rpx 16rpx 4rpx;
  font-size: 28rpx; font-weight: 500; color: #222;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.video-card__tittle {
  display: block; padding: 0 16rpx 6rpx;
  font-size: 22rpx; color: #888;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.video-card__count { padding: 0 16rpx 14rpx; font-size: 22rpx; color: #aaa; }

/* ============ 拍照识别 & 建筑可阅读（上下排列） ============ */
.entries {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 24rpx 24rpx;
}
.entry-card {
  background-color: #fff;
  border-radius: 14rpx;
  overflow: hidden;
}
.entry-card__cover {
  display: block;
  width: 100%;
  height: 340rpx;
}
.entry-card__body {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 160rpx;
  box-sizing: border-box;
  background-color: #fff;
}
.entry-card__icon { width: 60rpx; height: 60rpx; }
.entry-card__title {
  font-size: 44rpx;
  font-weight: 500;
  color: #222;
  letter-spacing: 2rpx;
}

.footer {
  display: block; margin-top: 60rpx; text-align: center;
  font-size: 22rpx; color: #bbb;
}
