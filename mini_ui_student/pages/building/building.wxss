/* pages/building/building.wxss - 建筑可阅读列表 */
.page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding: 20rpx 20rpx 60rpx;
  box-sizing: border-box;
}

/* ==================== 搜索栏 ==================== */
.searchbar {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 10rpx 10rpx 24rpx;
  margin-bottom: 24rpx;
}
.searchbar__near {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 16rpx;
  margin-right: 16rpx;
  border-right: 1rpx solid #eee;
}
.icon-loc {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #c9a24b;
  border-radius: 50%;
  box-sizing: border-box;
}
.icon-loc__dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  background-color: #c9a24b;
  border-radius: 50%;
}
.searchbar__near-text {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #c9a24b;
}
.searchbar__input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.searchbar__ph {
  color: #bbb;
}
.searchbar__btn {
  padding: 14rpx 34rpx;
  background-color: #c9a24b;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

/* ==================== 分类标签 ==================== */
.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background-color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #666;
}
.tab--active {
  background-color: #c9a24b;
  color: #fff;
}

/* ==================== 卡片瀑布流 ==================== */
.waterfall {
  display: flex;
  align-items: flex-start;
}
.waterfall__col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.waterfall__col:first-child { margin-right: 16rpx; }
.card {
  width: 100%;
  margin-bottom: 16rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card__imgwrap {
  position: relative;
}
.card__img {
  width: 100%;
  display: block;
  background-color: #eee;
}
.card__info {
  padding: 14rpx 16rpx 18rpx;
}
.card__name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card__en {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loading,
.end,
.empty {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 40rpx;
}
