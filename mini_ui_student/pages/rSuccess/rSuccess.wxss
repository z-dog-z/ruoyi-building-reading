.page {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: 80rpx;
}
.cover {
  width: 100%;
  height: 520rpx;
  display: block;
  background-color: #eee;
}
.info {
  padding: 32rpx;
}
.info__name {
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
}
.info__en {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
}
.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}
.nav-row__left { display: flex; align-items: center; gap: 14rpx; }
.nav-row__icon {
  position: relative;
  width: 28rpx; height: 28rpx;
  border: 3rpx solid #c9a24b;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  box-sizing: border-box;
}
.nav-row__icon::after {
  content: '';
  position: absolute;
  top: 7rpx; left: 7rpx;
  width: 8rpx; height: 8rpx;
  background-color: #c9a24b;
  border-radius: 50%;
}
.nav-row__label { font-size: 30rpx; color: #333; }
.lang-switch { display: flex; border-radius: 999rpx; overflow: hidden; border: 1rpx solid #e4b870; }
.lang-switch__item {
  width: 72rpx; height: 56rpx; line-height: 56rpx;
  text-align: center; font-size: 26rpx; color: #e4b870;
}
.lang-switch__item--active { background-color: #e4b870; color: #fff; }
.kv-list { padding: 0 32rpx; margin-top: 20rpx; }
.kv {
  display: flex; justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}
.kv__k { font-size: 28rpx; color: #999; }
.kv__v { font-size: 28rpx; color: #333; max-width: 60%; text-align: right; }
.btn {
  display: block;
  margin: 40rpx auto 0;
  width: 80%;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(90deg, #d4a64a, #e4b870);
  border-radius: 999rpx;
}
.btn--ghost {
  color: #d4a64a;
  background: transparent;
  border: 2rpx solid #d4a64a;
}
