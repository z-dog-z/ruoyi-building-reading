.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}
.loading, .empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.card__cover {
  width: 100%;
  display: block;
  background: #f0f0f0;
}
.card__cover--fallback {
  height: 400rpx;
  padding: 80rpx;
  box-sizing: border-box;
  object-fit: contain;
}
.card__body {
  padding: 20rpx 28rpx;
}
.card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
